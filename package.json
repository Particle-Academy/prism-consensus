{
  "name": "@particle-academy/prism-consensus",
  "version": "0.1.0",
  "private": true,
  "description": "A room where several agents and a human discuss a question and vote for consensus. The testbed that dogfoods prism-acp.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsc -p tsconfig.json && node dist/main.js",
    "link:acp": "node tools/link-acp.mjs"
  },
  "dependencies": {
    "@particle-academy/prism-acp": "file:vendor/prism-acp"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
